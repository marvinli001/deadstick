NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://deadstick:deadstick@localhost:5432/deadstick
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable: changing it makes stored subscriptions unreadable.
APP_KEY=
PUBLIC_URL=http://localhost:3000
# The API also serves the built web app (web/dist) on PUBLIC_URL. Add the Vite dev server for `pnpm dev:web`.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Exact trusted reverse-proxy IPs or CIDRs, comma separated. Empty = don't trust forwarding headers.
TRUST_PROXY=
LOG_LEVEL=info
# proxy = real TLS/HTTP egress through a sampled node; tcp = port reachability only.
# The Docker image includes /usr/local/bin/mihomo. Local runs need an installed binary.
PROBE_MODE=proxy
MIHOMO_BIN=/usr/local/bin/mihomo
POSTGRES_PASSWORD=
# Optional fallback: configure the bot in Console > Telegram > Settings instead.
# Console settings are encrypted in the database and take precedence. Never commit credentials.
TELEGRAM_BOT_TOKEN=
# Bot username without @; required for setup and deep-link buttons.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# BotFather > Login Widget (OIDC), not the bot token
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Only read by pnpm admin. Prefer a Telegram user ID; no email/password needed.
ADMIN_TELEGRAM_ID=
# Alternative: leave ADMIN_TELEGRAM_ID empty and use email/password.
# Remove ADMIN_PASSWORD after bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required to run database integration tests; use a disposable database.
TEST_DATABASE_URL=
